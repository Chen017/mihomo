@@ -0,0 +1,32 @@
+package provider
+
+import "testing"
+
+func TestProviderDialerCycles(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		mappings []map[string]any
+		bad      bool
+	}{
+		{"same provider", []map[string]any{{"name": "entry"}, {"name": "split", "dialer-proxy": "entry", "xhttp-opts": map[string]any{"download-settings": map[string]any{"dialer-proxy": ""}}}}, false},
+		{"external group", []map[string]any{{"name": "entry", "dialer-proxy": "external"}}, false},
+		{"self", []map[string]any{{"name": "entry", "dialer-proxy": "entry"}}, true},
+		{"download cycle", []map[string]any{{"name": "entry", "dialer-proxy": "split"}, {"name": "split", "xhttp-opts": map[string]any{"download-settings": map[string]any{"dialer-proxy": "entry"}}}}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := validateProviderDialers(tc.mappings, nil); (err != nil) != tc.bad {
+				t.Fatalf("error=%v want failure=%v", err, tc.bad)
+			}
+		})
+	}
+}
+
+func TestGlobalProxyBreaksApparentProviderCycle(t *testing.T) {
+	mappings := []map[string]any{{"name": "entry", "dialer-proxy": "split"}, {"name": "split", "xhttp-opts": map[string]any{"download-settings": map[string]any{"dialer-proxy": "entry"}}}}
+	if err := validateProviderDialers(mappings, map[string]struct{}{"entry": {}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateProviderDialers(mappings, map[string]struct{}{"other": {}}); err == nil {
+		t.Fatal("unrelated global hid a provider cycle")
+	}
+}
diff --git a/component/proxydialer/byname_test.go b/component/proxydialer/byname_test.go
new file mode 100644
--- /dev/null
+++ b/component/proxydialer/byname_test.go
@@ -0,0 +1,67 @@
+package proxydialer
+
+import (
+	"context"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"testing"
+)
+
+type testTunnel struct {
+	C.Tunnel
+	globals   map[string]C.Proxy
+	providers map[string]P.ProxyProvider
+}
+
+func (t testTunnel) Proxies() map[string]C.Proxy           { return t.globals }
+func (t testTunnel) Providers() map[string]P.ProxyProvider { return t.providers }
+
+type testProxy struct {
+	C.Proxy
+	name string
+}
+
+func (p *testProxy) Name() string { return p.name }
+
+type testProvider struct {
+	P.ProxyProvider
+	proxies []C.Proxy
+	touched int
+}
+
+func (p *testProvider) Proxies() []C.Proxy { return p.proxies }
+func (p *testProvider) Touch()             { p.touched++ }
+
+func TestProviderDialerScopeRefreshAndCycles(t *testing.T) {
+	first := &testProxy{name: "entry"}
+	second := &testProxy{name: "entry"}
+	foreign := &testProxy{name: "foreign"}
+	provider := &testProvider{proxies: []C.Proxy{first}}
+	tunnel := testTunnel{globals: map[string]C.Proxy{}, providers: map[string]P.ProxyProvider{"mine": provider, "other": &testProvider{proxies: []C.Proxy{foreign}}}}
+	d := byNameProxyDialer{proxyName: "entry", providerName: "mine", tunnel: tunnel}
+	ctx, p, err := d.resolve(context.Background())
+	if err != nil || p != first {
+		t.Fatalf("resolve = %v, %v", p, err)
+	}
+	if _, _, err = d.resolve(ctx); err == nil {
+		t.Fatal("cycle accepted")
+	}
+	provider.proxies = []C.Proxy{second}
+	if _, p, err = d.resolve(context.Background()); err != nil || p != second {
+		t.Fatal("provider refresh retained stale proxy")
+	}
+	d.proxyName = "foreign"
+	if _, _, err = d.resolve(context.Background()); err == nil {
+		t.Fatal("another provider was searched")
+	}
+	d.proxyName = "entry"
+	d.providerName = ""
+	if _, _, err = d.resolve(context.Background()); err == nil {
+		t.Fatal("global dialer searched arbitrary providers")
+	}
+	tunnel.globals["entry"] = first
+	d.tunnel = tunnel
+	if _, p, err = d.resolve(context.Background()); err != nil || p != first {
+		t.Fatal("global reference failed")
+	}
+}
diff --git a/transport/vless/encryption/ticket_test.go b/transport/vless/encryption/ticket_test.go
new file mode 100644
--- /dev/null
+++ b/transport/vless/encryption/ticket_test.go
@@ -0,0 +1,156 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/ecdh"
+	"crypto/rand"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func ticketTestConn(t *testing.T, wire, currentKey []byte) (*CommonConn, *ClientInstance) {
+	t.Helper()
+	a, b := net.Pipe()
+	t.Cleanup(func() { a.Close() })
+	a.SetDeadline(time.Now().Add(5 * time.Second))
+	go func() { defer b.Close(); b.Write(wire) }()
+	pfs := bytes.Repeat([]byte{1}, 64)
+	i := &ClientInstance{PfsKey: currentKey, Expire: time.Now().Add(time.Hour)}
+	c := NewCommonConn(a, true)
+	c.Client = i
+	c.UnitedKey = append(pfs, bytes.Repeat([]byte{2}, 32)...)
+	return c, i
+}
+
+func TestResumedTicketExpiresBeforeAuthenticatedResponse(t *testing.T) {
+	header := make([]byte, 5)
+	EncodeHeader(header, 17)
+	for name, wire := range map[string][]byte{
+		"early EOF":              nil,
+		"short random":           make([]byte, 7),
+		"invalid header":         make([]byte, 21),
+		"short record":           append(make([]byte, 16), header...),
+		"unauthenticated record": append(append(make([]byte, 16), header...), make([]byte, 17)...),
+	} {
+		t.Run(name, func(t *testing.T) {
+			c, i := ticketTestConn(t, wire, bytes.Repeat([]byte{1}, 64))
+			if _, err := c.Read(make([]byte, 32)); err == nil {
+				t.Fatal("expected rejected session")
+			}
+			if time.Now().Before(i.Expire) {
+				t.Fatal("failed 0-RTT ticket remained cached")
+			}
+		})
+	}
+}
+
+func TestOldFailureDoesNotExpireNewTicket(t *testing.T) {
+	c, i := ticketTestConn(t, nil, bytes.Repeat([]byte{3}, 64))
+	c.Read(make([]byte, 32))
+	if !time.Now().Before(i.Expire) {
+		t.Fatal("old connection expired a newer ticket")
+	}
+}
+
+func TestAuthenticatedResumptionKeepsTicketAfterClose(t *testing.T) {
+	random := bytes.Repeat([]byte{4}, 16)
+	key := append(bytes.Repeat([]byte{1}, 64), bytes.Repeat([]byte{2}, 32)...)
+	header := make([]byte, 5)
+	EncodeHeader(header, 18)
+	wire := append(append([]byte{}, random...), NewAEAD(random, key, true).Seal(header, nil, []byte("ok"), header)...)
+	c, i := ticketTestConn(t, wire, bytes.Repeat([]byte{1}, 64))
+	data := make([]byte, 32)
+	if n, err := c.Read(data); err != nil || string(data[:n]) != "ok" {
+		t.Fatalf("response: %q %v", data[:n], err)
+	}
+	if _, err := c.Read(data); err != io.EOF {
+		t.Fatalf("close: %v", err)
+	}
+	if !time.Now().Before(i.Expire) {
+		t.Fatal("normal stream close expired a valid ticket")
+	}
+}
+
+func TestZeroRTTResumptionAndServerRestart(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &ServerInstance{}
+	if err := server.Init([][]byte{key.Bytes()}, 2, 600, 0, "100-35-35"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { server.Close() })
+	client := &ClientInstance{}
+	if err := client.Init([][]byte{key.PublicKey().Bytes()}, 2, 1, "100-35-35"); err != nil {
+		t.Fatal(err)
+	}
+	exchange := func(wantZero, rejected bool) {
+		t.Helper()
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer listener.Close()
+		a, err := net.Dial("tcp", listener.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		b, err := listener.Accept()
+		if err != nil {
+			a.Close()
+			t.Fatal(err)
+		}
+		defer a.Close()
+		a.SetDeadline(time.Now().Add(5 * time.Second))
+		b.SetDeadline(time.Now().Add(5 * time.Second))
+		result := make(chan error, 1)
+		go func() {
+			defer b.Close()
+			c, err := server.Handshake(b, nil)
+			if err == nil {
+				var data [4]byte
+				_, err = io.ReadFull(c, data[:])
+				if err == nil && string(data[:]) != "ping" {
+					err = io.ErrUnexpectedEOF
+				}
+				if err == nil {
+					_, err = c.Write([]byte("pong"))
+				}
+			}
+			result <- err
+		}()
+		c, err := client.Handshake(a)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if (len(c.PreWrite) > 0) != wantZero {
+			t.Fatalf("0-RTT=%v, wanted %v", len(c.PreWrite) > 0, wantZero)
+		}
+		written := make(chan error, 1)
+		go func() { _, err := c.Write([]byte("ping")); written <- err }()
+		var response [4]byte
+		_, err = io.ReadFull(c, response[:])
+		a.Close()
+		writeErr, serverErr := <-written, <-result
+		if rejected {
+			if err == nil || serverErr == nil {
+				t.Fatal("expired ticket was accepted")
+			}
+			return
+		}
+		if err != nil || writeErr != nil || serverErr != nil || string(response[:]) != "pong" {
+			t.Fatalf("round trip: %q %v %v %v", response, err, writeErr, serverErr)
+		}
+	}
+	exchange(false, false) // First connection obtains a ticket.
+	exchange(true, false)  // Subsequent connection actually takes the zero-RTT path.
+	server.RWLock.Lock()
+	server.Sessions = make(map[[16]byte]*ServerSession) // Equivalent to losing sessions on restart.
+	server.RWLock.Unlock()
+	exchange(true, true)
+	exchange(false, false) // Reacquire once; the client and its config stay unchanged.
+	exchange(true, false)
+}
